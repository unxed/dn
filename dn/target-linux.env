# the symbols of the Linux target of the tree (PLAN.md, "Линуксовый шоукейс": i386-linux first)
# LINUX: a symbol of Virtual Pascal (the Linux target of VP); OS2, WIN32 and DPMI32 are not defined, so the generic
# branches of the 32-bit code remain.
DN_DEFINES="DPMI32 LINUX VIRTUALPASCAL DN DNPRG"
# DN OSP keeps the units that differ between the systems in LIB.D32, LIB.OLF, LIB.WLF; Linux has none: the units of the
# layer are ours (dn/new-linux)
DN_LIB_DIR="LIB.D32"
DN_FPC_OPTS="-Mdelphi -Sh- -Rintel -dDPMI32 -dLINUX"
