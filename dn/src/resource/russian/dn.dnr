    COMMAND       cmSwitchBlock,  0,             0,         ^B^V,      #0#0
    COMMAND       cmFJustify,     kbAltJ,        0,         ^B^J,      #0#0
    COMMAND       cmFRight,       kbAltR,        0,         ^B^R,      #0#0
    COMMAND       cmFLeft,        kbAltL,        0,         ^B^L,      #0#0
    COMMAND       cmFCenter,      kbAltC,        0,         ^B^C,      #0#0
