DIALOG dlgCountrySetup, 54, 22, 'Country information'
    HELPCTX hcCountrySetup
    RadioButtons 2, 3, 22, 6
      ITEM '~M~onth-Day-Year'
      ITEM '~D~ay-Month-Year'
      ITEM '~Y~ear-Month-Day'
      END
    Label 2, 2, 'Date ~f~ormat'
    RadioButtons 24, 3, 36, 5
      ITEM '~1~2 hour'
      ITEM '~2~4 hour'
      END
    Label 23, 2, 'Time f~o~rmat'
    InputLine 23, 7, 26, 8, 1, 0
    Label 2, 7, 'D~a~te separator'
    InputLine 23, 8, 26, 9, 1, 0
    Label 2, 8, 'T~i~me separator'
    InputLine 23, 9, 26, 10, 1, 0
    Label 2, 9, '~T~housands separator'
    InputLine 23, 10, 26, 11, 1, 0
    Label 2, 10, 'Decima~l~ separator'
    InputLine 23, 11, 26, 12, 1, 0
    Label 2, 11, 'C~u~rrency decimals'
    RadioButtons 38, 3, 52, 8
      ITEM '$123.00'
      ITEM '123.00$'
      ITEM '$ 123.00'
      ITEM '123.00 $'
      ITEM '123$00'
      END
    Label 36, 2, 'Cu~r~rency format'
    InputLine 46, 9, 52, 10, 4, 0
    Label 28, 9, '~C~urrency symbol'
    InputLine 36, 11, 50, 12, 79, hsKbdToggleLayot
    Label 26, 11, 'Key~b~oard'
    InputLine 36, 13, 50, 14, 79, hsWinCodeTable
    Label 16, 13, 'Al~p~habetic Sorting'
    InputLine 36, 15, 50, 16, 79, hsABCSortTable
    Label 30, 15, '~W~IN:'
    InputLine 2, 17, 50, 18, 255, hsCodeTables
    Label 1, 16, 'Additional codetabl~e~s'
    Button 27, 6, 37, 8, '~S~ystem', cmYes
    Button 7, 19, 17, 21, 'O~K~', cmOK, bfDefault
    Button 22, 19, 32, 21, 'Ca~n~cel', cmCancel
    Button 37, 19, 47, 21, '~H~elp', cmHelp
END

