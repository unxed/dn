EDITOR COMMANDS
;Format is:  COMMAND  <Command>,  KeyCode1,      KeyCode2,  CtrlCode1, CtrlCode2
    COMMAND       cmDeleteLine,   0,             0,         ^Y#0,      #0#0
    COMMAND       cmDelWordLeft,  kbCtrlBack,    0,         #0#0,      #0#0
    COMMAND       cmDelWordRight, 0,             0,         ^T#0,      #0#0
    COMMAND       cmSpecChar,     0,             0,         ^P#0,      #0#0
    COMMAND       cmUndo,         kbAltBack,     0,         ^Q^L,      #0#0
    COMMAND       cmCtrlHome,     kbCtrlHome, kbCtrlShiftHome, #0#0,   #0#0
    COMMAND       cmCtrlEnd,      kbCtrlEnd,  kbCtrlShiftEnd,  #0#0,   #0#0
    COMMAND       cmDeltoEOLN,    0,             0,         ^Q^Y,      #0#0
    COMMAND       cmStartSearch,  0,             0,         ^Q^F,      #0#0
    COMMAND       cmReplace,      0,             0,         ^Q^A,      #0#0
    COMMAND       cmMoveBlockStart, 0,           0,         ^Q^B,      #0#0
    COMMAND       cmMoveBlockEnd, 0,             0,         ^Q^K,      #0#0
    COMMAND       cmContSearch,   0,             0,         ^L#0,      #0#0
    COMMAND       cmBlockRead,    0,             0,         ^K^R,      #0#0
    COMMAND       cmBlockWrite,   0,             0,         ^K^W,      #0#0
    COMMAND       cmSwitchIns,    kbIns,         0,         ^V,        #0#0
    COMMAND       cmSwitchBlock,  0,             0,         ^B^V,      #0#0
    COMMAND       cmFJustify,     kbAltJ,        0,         ^B^J,      #0#0
    COMMAND       cmFRight,       kbAltR,        0,         ^B^R,      #0#0
    COMMAND       cmFLeft,        kbAltL,        0,         ^B^L,      #0#0
    COMMAND       cmFCenter,      kbAltC,        0,         ^B^C,      #0#0
