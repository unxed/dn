DIALOG dlgNameCase, 40, 12, 'Зміна регістра імен'
    HelpCtx hcChangeNameCase
    RadioButtons 2, 3, 22, 8, ofPostProcess, ofPreProcess
      ITEM 'LoNg FIle nAMe'
;      ITEM 'Не міняти'
      ITEM 'long file name'
      ITEM 'Long file name'
      ITEM 'Long File Name'
      ITEM 'LONG FILE NAME'
    END
    Label 2, 2, '~І~м''я', ofPostProcess, ofPreProcess
    RadioButtons 24, 3, 38, 8, ofPostProcess, ofPreProcess
      ITEM 'LoNg eXt'
;      ITEM 'Не міняти'
      ITEM 'long ext'
      ITEM 'Long ext'
      ITEM 'Long Ext'
      ITEM 'LONG EXT'
    END
    Label 24, 2, '~Р~озширення', ofPostProcess, ofPreProcess
    Button  2, 9, 13, 11,  'O~K~',  cmOK,     bfDefault, ofPostProcess, ofPreProcess
    Button 13, 9, 24, 11, 'Відміна', cmCancel, bfNormal,  ofPostProcess, ofPreProcess
    Button 24, 9, 36, 11, 'Допомога', cmHelp,   bfNormal,  ofPostProcess, ofPreProcess
END
;DataCompBoy
;JO
DIALOG dlgChScreenMode, 37, 12, 'Змінити відеорежим'
    HELPCTX hcNoContext
    RadioButtons 2, 2, 35, 8, ofPostProcess, ofPreProcess
      ITEM '~1~ 80 x 25 '
      ITEM '~2~ 80 x 30 '
      ITEM '~3~ 80 x 34 '
      ITEM '~4~ 80 x 43 '
      ITEM '~5~ 80 x 50 '
      ITEM '~6~ 80 x 60 '
      ITEM '~Д~овільний:'
    END
    StaticText 16, 2, 17, 3, '│'
    StaticText 16, 3, 17, 4, '│'
    StaticText 16, 4, 17, 5, '│'
    StaticText 16, 5, 17, 6, '│'
    StaticText 16, 6, 17, 7, '│'
    StaticText 16, 7, 17, 8, '│'
