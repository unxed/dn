    COMMAND       cmDeleteLine,   0,             0,         ^Y#0,      #0#0
    COMMAND       cmDelWordLeft,  kbCtrlBack,    0,         #0#0,      #0#0
    COMMAND       cmDelWordRight, 0,             0,         ^T#0,      #0#0
    COMMAND       cmSpecChar,     0,             0,         ^P#0,      #0#0
    COMMAND       cmUndo,         kbAltBack,     0,         ^Q^L,      #0#0
    COMMAND       cmCtrlHome,     kbCtrlHome, kbCtrlShiftHome, #0#0,   #0#0
    COMMAND       cmCtrlEnd,      kbCtrlEnd,  kbCtrlShiftEnd,  #0#0,   #0#0
