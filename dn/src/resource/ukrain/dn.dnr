      ITEM 'У вигляді рядка'
      ITEM 'У вигляді обчисленого значення'
    END
    Label 3, 8, 'Зберігання ~ф~ормул:', ofPostProcess, ofPreProcess
    Button 11, 13, 21, 15, 'О~К~', cmOK, bfDefault, ofPostProcess, ofPreProcess
    Button 25, 13, 35, 15, 'Відміна', cmCancel, ofPostProcess, ofPreProcess
END
;KV

