   ║  │     │      │    │операції│         │  ▒
   ║  │     │      │    │з блока-│   установка▒
   ║  │     │      │    │ми та   │  параметрів▒
   ║  │     │      │    └абзацами┘   редактора ▒
   ║  │     │      │                          ▒
   ║  │     │      └ операції пошуку          ▒
