# the 64-bit Linux build (x86_64, the native fpc): the 32-bit target of target-linux.env with NOASM (the Pascal versions of the
# routines that the authors of DN wrote in the assembler: it is Intel with 32-bit registers and cannot run on x86_64) and CPUX86_64
. "$(dirname "$DN_TARGET_ENV")/target-linux.env"
DN_DEFINES="$DN_DEFINES NOASM CPUX86_64"
DN_FPC_OPTS="$DN_FPC_OPTS -dNOASM"
