# the symbols of the target of the tree (PLAN.md, milestone 5: DOS, go32v2)
# VIRTUALPASCAL: DN OSP is a Virtual Pascal project; its STDEFINE.INC takes the branch of the real build (BIT_32, FILE_32,
# DualName, USELFN...) only when VP is defined (NONBP follows from it). FPC does the job of VP here.
# DN and DNPRG are the symbols of the command line of the original build (_dnc.cmd: vpc dn /dDN /dDNPRG): DNPRG = the program (not the plugin)
DN_DEFINES="DPMI32 VIRTUALPASCAL DN DNPRG"
# the directory of the archive with the units of this target (DPMI32 = DOS 32-bit)
DN_LIB_DIR="LIB.D32"
# the options of FPC for the units of DN: Delphi mode (as VP: procedures as values without @, Result), short
# strings (String = ShortString, as in VP), Intel assembler
DN_FPC_OPTS="-Mdelphi -Sh- -Rintel -dDPMI32"
