# The options of the compiler for the builds of DN (tools/build.sh, tools/dn-env.sh).
# Delphi mode (as VP: procedures as values without @, Result), short strings (String = ShortString, as in VP), Intel assembler
# (the tree has no assembler left: bootstrap/tree.env, NOASM).
DN_FPC_COMMON="-Mdelphi -Sh- -Rintel -Se300"
# dos: go32v2 (the DOS extender CWSDPMI, DOSBox-X or real DOS); DPMI32 is the system of the sources (the 32-bit flat code with the long
# file names): all the builds are it. linux: i386-linux (static, runs on a 64-bit kernel). linux64: x86_64-linux (native fpc).
DN_OPT_dos="-dDPMI32"
DN_OPT_linux="-dDPMI32 -dLINUX"
DN_OPT_linux64="-dDPMI32 -dLINUX"
# aarch64: aarch64-linux (static, runs on an ARM64 Linux; tools/build-fpc-aarch64-linux.sh); the same units as linux64
DN_OPT_aarch64="-dDPMI32 -dLINUX"
DN_UNITS_aarch64="src-linux"
# directories of units that come before dn/src (our units that replace those of the tree in this build)
DN_UNITS_linux="src-linux"
DN_UNITS_linux64="src-linux"
# win64, win32: Windows (the console with the sequences of a terminal: Windows 10 and newer, Wine); the same units that replace those of the tree as linux
DN_OPT_win64="-dDPMI32"
DN_OPT_win32="-dDPMI32"
DN_UNITS_win64="src-linux"
DN_UNITS_win32="src-linux"
