# The options of the compiler for the builds of DN (tools/build.sh, tools/dn-env.sh).
# Delphi mode (as VP: procedures as values without @, Result), short strings (String = ShortString, as in VP), Intel assembler
# (the tree has no assembler left: bootstrap/tree.env, NOASM).
DN_FPC_COMMON="-Mdelphi -Sh- -Rintel -Se300"
# dos: go32v2 (the DOS extender CWSDPMI, DOSBox-X or real DOS); DPMI32 is the system of the sources (the 32-bit flat code with the long
# file names): all the builds are it. -gl (the lines of the sources in the call stack of a crash report: flightrec.pas) everywhere but DOS (the size). linux: i386-linux (static, runs on a 64-bit kernel). linux64: x86_64-linux (native fpc).
DN_OPT_dos="-dDPMI32"
DN_OPT_linux="-gl -dDPMI32 -dLINUX"
DN_OPT_linux64="-gl -dDPMI32 -dLINUX"
# aarch64: aarch64-linux (static, runs on an ARM64 Linux; tools/build-fpc-aarch64-linux.sh); the same units as linux64
DN_OPT_aarch64="-gl -dDPMI32 -dLINUX"
DN_UNITS_aarch64="compat/linux"
# directories of units that come after dn/src, archives, compat and replace the units of the same name (our units for this build)
DN_UNITS_linux="compat/linux"
DN_UNITS_linux64="compat/linux"
# win64, win32: Windows (the console with the sequences of a terminal: Windows 10 and newer, Wine); the same units that replace those of the tree as linux
DN_OPT_win64="-gl -dDPMI32"
DN_OPT_win32="-gl -dDPMI32"
DN_UNITS_win64="compat/linux"
DN_UNITS_win32="compat/linux"
# The builds of a release and of the nightly snapshot (DN_RELEASE=1, tools/dn-env.sh): optimized (-O2), smart linking (-CX -XX: only the routines
# that are used), no symbols (-Xs) and no line information (the -gl of the targets is dropped): about a quarter of the size. A crash report of such
# a build gives addresses only; a build of the same commit with -gl finds their lines.
DN_OPT_release="-O2 -CX -XX -Xs"
# The mini build (DN_MINI=1, tools/dn-env.sh; always a release): a smaller DN without the parts that a file manager can do without: the
# game, the calculator and the spreadsheet, the phone book and the dialer, Arvid (tape drives), UUE, the DBF viewer, the disassembler of the
# viewer, the printing, the calendar, the ASCII table, the disk images, the embedded terminal (a command gets the terminal, as with
# DN_EMBED_TERM=0) and the archive formats other than ARJ, CAB, LHA, RAR, ZIP, TAR, GZ, 7Z, BZ2 and XZ. Their menu items are not shown
# (mainapp.CommandHidden). The panels, the file operations, the viewer, the editor, the command line, the menus and the dialogs stay.
DN_OPT_mini="-dDN_MINI"
